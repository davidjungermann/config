#!/bin/zsh
set -euo pipefail

task_source="$HOME/.kube/config"
task_dev="$HOME/.kube/dev"
task_production="$HOME/.kube/production"

task_usage() {
    cat <<'EOF'
Usage: kubeconfig-split [--source PATH]

Interactively classify contexts from an existing kubeconfig as dev,
production, or skipped. Writes ~/.kube/dev and ~/.kube/production.
EOF
}

while (( $# > 0 )); do
    case "$1" in
        --source)
            (( $# >= 2 )) || { echo "--source requires a path" >&2; exit 2; }
            task_source="$2"
            shift 2
            ;;
        -h|--help)
            task_usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            task_usage >&2
            exit 2
            ;;
    esac
done

command -v kubectl >/dev/null 2>&1 || {
    echo "kubectl is required" >&2
    exit 1
}
[[ -f "$task_source" ]] || {
    echo "Kubeconfig not found: $task_source" >&2
    exit 1
}

if [[ "${task_source:A}" == "${task_dev:A}" || \
      "${task_source:A}" == "${task_production:A}" ]]; then
    echo "Source must be a combined kubeconfig, not an output file: $task_source" >&2
    echo "Use --source PATH to select a combined kubeconfig or backup." >&2
    exit 1
fi

local -a task_contexts task_dev_contexts task_production_contexts
task_contexts=("${(@f)$(kubectl --kubeconfig="$task_source" config get-contexts -o name)}")
(( ${#task_contexts} > 0 )) || {
    echo "No contexts found in $task_source" >&2
    exit 1
}

echo "Classify contexts from $task_source"
echo "  d = dev, p = production, s = skip"
echo

for task_context in "${task_contexts[@]}"; do
    while true; do
        read -r "task_choice?$task_context [d/p/s]: "
        case "${task_choice:l}" in
            d|dev)
                task_dev_contexts+=("$task_context")
                break
                ;;
            p|prod|production)
                task_production_contexts+=("$task_context")
                break
                ;;
            s|skip|'')
                break
                ;;
            *)
                echo "Enter d, p, or s."
                ;;
        esac
    done
done

(( ${#task_dev_contexts} > 0 )) || {
    echo "At least one dev context is required." >&2
    exit 1
}
(( ${#task_production_contexts} > 0 )) || {
    echo "At least one production context is required." >&2
    exit 1
}

task_choose_default() {
    local task_label="$1"
    shift
    local -a task_choices=("$@")
    local task_default="${task_choices[1]}"

    echo >&2
    echo "$task_label contexts: ${(j:, :)task_choices}" >&2
    while true; do
        read -r "task_selected?Default $task_label context [$task_default]: "
        task_selected="${task_selected:-$task_default}"
        if (( ${task_choices[(Ie)$task_selected]} )); then
            echo "$task_selected"
            return 0
        fi
        echo "Choose one of: ${(j:, :)task_choices}" >&2
    done
}

task_dev_default="$(task_choose_default dev "${task_dev_contexts[@]}")"
task_production_default="$(task_choose_default production "${task_production_contexts[@]}")"

task_temp_dir="$(mktemp -d /private/tmp/kubeconfig-split.XXXXXX)"
trap 'rm -r "$task_temp_dir"' EXIT

task_build_config() {
    local task_output="$1"
    local task_default="$2"
    shift 2
    local -a task_parts
    local task_index=0

    for task_context in "$@"; do
        task_index=$((task_index + 1))
        local task_working="$task_temp_dir/context-$task_index.working"
        local task_part="$task_temp_dir/context-$task_index.yaml"
        cp "$task_source" "$task_working"
        kubectl --kubeconfig="$task_working" config use-context "$task_context" >/dev/null
        kubectl --kubeconfig="$task_working" config view \
            --minify --flatten --raw > "$task_part"
        task_parts+=("$task_part")
    done

    KUBECONFIG="${(j/:/)task_parts}" kubectl config view \
        --flatten --raw > "$task_output"
    kubectl --kubeconfig="$task_output" config use-context "$task_default" >/dev/null
    chmod 600 "$task_output"
}

task_new_dev="$task_temp_dir/dev"
task_new_production="$task_temp_dir/production"
task_build_config "$task_new_dev" "$task_dev_default" "${task_dev_contexts[@]}"
task_build_config "$task_new_production" "$task_production_default" \
    "${task_production_contexts[@]}"

mkdir -p "$HOME/.kube"
task_timestamp="$(date +%Y%m%d-%H%M%S).$$"
for task_output in "$task_dev" "$task_production"; do
    if [[ -e "$task_output" || -L "$task_output" ]]; then
        mv "$task_output" "$task_output.before-split.$task_timestamp"
    fi
done
mv "$task_new_dev" "$task_dev"
mv "$task_new_production" "$task_production"

echo
echo "Created $task_dev (default: $task_dev_default)"
echo "Created $task_production (default: $task_production_default)"
echo "Switch with: kubeconfig dev | kubeconfig production"

#!/bin/zsh
set -euo pipefail

# Non-interactive access to the kubeconfig files written by kubeconfig-split.
# A script cannot change its caller's environment, so commands run through it:
#   kubeconfig dev -- kubectl get pods
# The interactive zsh function in .zshrc wraps this to switch the current shell.

kube_dev="$HOME/.kube/dev"
kube_production="$HOME/.kube/production"

usage() {
    cat <<'EOF'
Usage:
  kubeconfig {dev|production} -- COMMAND [ARGS...]  Run COMMAND with that kubeconfig
  kubeconfig path {dev|production}                  Print the kubeconfig path
  kubeconfig check                                  Fail if dev contains production clusters

In an interactive zsh, `kubeconfig dev|production` switches the current shell.
EOF
}

cluster_servers() {
    kubectl --kubeconfig="$1" config view \
        -o jsonpath='{range .clusters[*]}{.cluster.server}{" "}{.name}{"\n"}{end}'
}

# Production clusters must only live in ~/.kube/production.
check_dev() {
    local -a production_servers leaked
    production_servers=("${(@f)$(cluster_servers "$kube_production" | cut -d' ' -f1)}")
    local line
    for line in "${(@f)$(cluster_servers "$kube_dev")}"; do
        [[ -n "$line" ]] || continue
        (( ${production_servers[(Ie)${line%% *}]} )) && leaked+=("${line#* }")
    done
    if (( ${#leaked} > 0 )); then
        echo "$kube_dev contains production clusters: ${(j:, :)leaked}" >&2
        echo "Remove them; production contexts belong only in $kube_production." >&2
        return 1
    fi
}

resolve() {
    case "$1" in
        dev) local f="$kube_dev" ;;
        production) local f="$kube_production" ;;
        *) usage >&2; exit 2 ;;
    esac
    [[ -f "$f" ]] || { echo "Missing $f; run kubeconfig-split first." >&2; exit 1; }
    [[ -f "$kube_production" ]] || { echo "Missing $kube_production; run kubeconfig-split first." >&2; exit 1; }
    [[ "$1" == dev ]] && { check_dev || exit 1; }
    echo "$f"
}

command -v kubectl >/dev/null 2>&1 || { echo "kubectl is required" >&2; exit 1; }

case "${1:-}" in
    -h|--help) usage ;;
    check) resolve dev >/dev/null; echo "OK: $kube_dev has no production clusters" ;;
    path)
        (( $# == 2 )) || { usage >&2; exit 2; }
        resolve "$2"
        ;;
    dev|production)
        if (( $# < 3 )) || [[ "$2" != "--" ]]; then
            echo "A script cannot switch your shell. Use: kubeconfig $1 -- COMMAND" >&2
            exit 2
        fi
        target="$(resolve "$1")"
        shift 2
        echo "[kubeconfig] $target (context: $(kubectl --kubeconfig="$target" config current-context))" >&2
        KUBECONFIG="$target" exec "$@"
        ;;
    *) usage >&2; exit 2 ;;
esac
